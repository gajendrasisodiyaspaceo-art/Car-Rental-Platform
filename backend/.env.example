# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/car_rental

# Auth
# In production JWT_SECRET must be a strong random string (>= 32 chars);
# the app refuses to boot with a weak/default secret when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5

# CORS (comma-separated origins; * allows all in dev)
CORS_ORIGIN=*

# Express `trust proxy` — only set when behind a load balancer so rate-limit
# keys use the real client IP. e.g. TRUST_PROXY=1 or TRUST_PROXY=loopback.
# Leave unset (default false) when not behind a proxy to avoid XFF spoofing.
# TRUST_PROXY=1
