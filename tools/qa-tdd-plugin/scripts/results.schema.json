{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Test Results",
  "type": "object",
  "required": ["meta", "summary", "testCases"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project", "app", "date"],
      "properties": {
        "project": { "type": "string" },
        "app": { "type": "string", "enum": ["backend", "web", "mobile", "all"] },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "commit": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "coveragePct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "title", "type", "priority", "expected", "status"],
        "properties": {
          "id": { "type": "string" },
          "module": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["happy", "edge", "negative", "rbac", "ownership", "security", "error", "idempotency", "concurrency"] },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "steps": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip", "blocked"] },
          "severity": { "type": "string", "enum": ["", "critical", "high", "medium", "low"] },
          "notes": { "type": "string" }
        }
      }
    },
    "security": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "severity", "status"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "location": { "type": "string" },
          "description": { "type": "string" },
          "recommendation": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "fixed", "accepted-risk"] }
        }
      }
    }
  }
}
